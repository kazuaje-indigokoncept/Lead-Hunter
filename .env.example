# Usuario administrador inicial (solo se usa la primera vez que arranca)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# ¿Olvidaste la contraseña? Define esta variable, reinicia, entra y luego bórrala.
# Mientras exista, la contraseña del usuario ADMIN_USER se vuelve a fijar en cada arranque.
# RESET_ADMIN_PASSWORD=

# Dirección pública. Con la IP 72.60.10.20 usa: 72-60-10-20.sslip.io (HTTPS gratis sin dominio)
SITE_ADDRESS=:80
# Pon 1 cuando uses HTTPS
SECURE_COOKIE=0
